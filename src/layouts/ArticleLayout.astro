---
import type { MarkdownHeading } from "astro";
import GeneralLayout from "./GeneralLayout.astro";
import ArticleNavigator from "../components/ArticleNavigator.vue";

interface Props {
    headings? :MarkdownHeading[]
}

const {
    headings = []
} = Astro.props

---

<GeneralLayout>
    <div slot="breadcrumb">
        <slot name="breadcrumb"/>
    </div>
    <div slot="title">
        <slot name="title"/>
    </div>
    <div slot="description">
        <slot name="description"/>
    </div>
    <div slot="secondary-descriptions">
        <slot name="secondary-descriptions"/>
    </div>
    <div slot="content" class="article-view">
        <ArticleNavigator structure={headings} client:load/>
        <div class="article-section">
            <slot name="content"></slot>
        </div>
    </div>
</GeneralLayout>

<style>
.article-view {
    display: flex;
    flex-direction: row;
    gap: var(--space-30);
}

.article-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
    max-width: 800px;

    font-family: var(--font-family-sans);
}
</style>