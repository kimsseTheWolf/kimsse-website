---
import type { MarkdownHeading } from "astro";
import GeneralLayout from "./GeneralLayout.astro";
import ArticleNavigator from "../components/ArticleNavigator.vue";
import 'katex/dist/katex.min.css';

interface Props {
    headings? :MarkdownHeading[]
}

const {
    headings = []
} = Astro.props

---

<GeneralLayout>
    <div slot="breadcrumb">
        <slot name="breadcrumb"/>
    </div>
    <div slot="title">
        <slot name="title"/>
    </div>
    <div slot="description">
        <slot name="description"/>
    </div>
    <div slot="secondary-descriptions">
        <slot name="secondary-descriptions"/>
    </div>
    <div slot="content" class="article-view">
        <ArticleNavigator structure={headings} client:load/>
        <div class="article-section">
            <slot name="content"></slot>
        </div>
    </div>
</GeneralLayout>

<style>
.article-view {
    display: flex;
    flex-direction: row;
    gap: var(--space-30);
}

@media (max-width: 767px) {
    .article-view {
        flex-direction: column;
    }
}

.article-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
    max-width: 800px;

    font-family: var(--font-family-sans);
}

.article-section :global(is(h1, h2, h3, h4, h5, h6)): {
    font-weight: var(--font-weight-black);
}

.article-section :global(p) {
    line-height: 1.6;
}

.article-section :global(a) {
    color: dodgerblue;
}

.article-section :global(img) {
    display: block;

    width: auto;
    height: auto;

    max-width: 100%;
    max-height: 500px;

    object-fit: contain;
    margin-inline: auto;
}

/* Table */
.article-section :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
}

/* Table Cells */
.article-section :global(th),
.article-section :global(td) {
    padding: 12px 16px;
    border-bottom: 1px solid #ccc;
    text-align: left;
}

/* Table Headers */
.article-section :global(th) {
    font-weight: 700;
    border-bottom: 2px solid #888;
}

/* Table Rows */
.article-section :global(tr) {
    background: transparent;
}



.article-section :global(pre.astro-code) {
    width: 100%;
    box-sizing: border-box;

    max-height: 400px;
    overflow: auto;

    padding: 1.25rem 1.5rem;
    margin-block: 1.5rem;

    font-family: var(--font-family-mono);
    font-size: var(--font-size-14);
    line-height: 1;

    white-space: pre;
    border-radius: 6px;
}

.article-section :global(pre.astro-code code) {
    font-family: inherit;
    font-size: inherit;
    line-height: inherit;
    white-space: inherit;
}

/* Remove previous line numbers */
.article-section :global(pre.astro-code .line::before) {
    content: none;
}

.article-section :global(pre.astro-code .line) {
    display: block;
    white-space: pre;
}

.article-section :global(iframe) {
    width: 100%;
    aspect-ratio: 16/9;
}
</style>