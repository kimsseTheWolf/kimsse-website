---
import GeneralLayout from "../layouts/GeneralLayout.astro";
import ProjectGrid from "../components/ProjectGrid.vue";

import { getCollection } from "astro:content";

const works = (await getCollection("works"))
---

<GeneralLayout>
    <div slot="breadcrumb" style="display: none;"/>
    <div slot="title">WORKS_</div>
    <div slot="description">All previous works, in one place.</div>
    <div slot="secondary-descriptions" style="display: none;"/>
    <div slot="content">
        <ProjectGrid contentType={"works"} projects={works} client:load></ProjectGrid>
    </div>
</GeneralLayout>